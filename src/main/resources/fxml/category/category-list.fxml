<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <top>
        <VBox spacing="10">
            <Label text="Quản lý danh mục" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <HBox spacing="8">
                <TextField fx:id="nameTextField" promptText="Tên danh mục mới..." prefWidth="220"/>
                <Button fx:id="addButton" text="+ Thêm danh mục"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="categoryTableView">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                <TableColumn fx:id="nameColumn" text="Tên danh mục" prefWidth="240"/>
                <TableColumn fx:id="actionColumn" text="Thao tác" prefWidth="140"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
