<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <top>
        <Label text="Dashboard - Tổng quan kho hàng" style="-fx-font-size: 16px; -fx-font-weight: bold;">
            <BorderPane.margin><Insets bottom="12"/></BorderPane.margin>
        </Label>
    </top>
    <center>
        <VBox spacing="16">
            <HBox spacing="16">
                <VBox style="-fx-border-color: #cccccc; -fx-border-radius: 4;" prefWidth="220" spacing="4">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <Label text="Tổng số sản phẩm"/>
                    <Label fx:id="totalProductsLabel" text="--" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox style="-fx-border-color: #cccccc; -fx-border-radius: 4;" prefWidth="220" spacing="4">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <Label text="Tổng giá trị tồn kho"/>
                    <Label fx:id="totalStockValueLabel" text="--" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox style="-fx-border-color: #cccccc; -fx-border-radius: 4;" prefWidth="220" spacing="4">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <Label text="Sản phẩm sắp hết hàng"/>
                    <Label fx:id="lowStockCountLabel" text="--" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <BarChart fx:id="importExportChart" prefHeight="320" legendVisible="true">
                <xAxis>
                    <CategoryAxis fx:id="monthAxis" label="Tháng"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="quantityAxis" label="Số lượng"/>
                </yAxis>
            </BarChart>
        </VBox>
    </center>
</BorderPane>
