<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.team.warehouse.warehousemanagementoop.controller.UserEditFormController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Sửa thông tin người dùng" />

    <GridPane hgap="10" vgap="12">
        <Label text="Tên đăng nhập:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtUsername" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Họ tên:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtFullName" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Mật khẩu:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtPassword" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Vai trò:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <ComboBox fx:id="cbRole" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Trạng thái:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <CheckBox fx:id="chkActive" selected="true" text="Hoạt động" GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnSave" onAction="#handleSave" text="Lưu" defaultButton="true" style="-fx-background-color: #28a745; -fx-text-fill: white;" />
        <Button fx:id="btnDelete" onAction="#handleDelete" text="Xóa" style="-fx-background-color: #dc3545; -fx-text-fill: white;" />
    </HBox>
</VBox>
