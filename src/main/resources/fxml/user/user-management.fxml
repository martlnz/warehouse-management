<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <top>
        <VBox spacing="10">
            <Label text="Quản lý người dùng" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <HBox spacing="8">
                <TextField fx:id="searchTextField" promptText="Tìm theo tên đăng nhập..." prefWidth="220"/>
                <Button fx:id="searchButton" text="Tìm kiếm"/>
                <Button fx:id="addButton" text="+ Thêm người dùng"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="userTableView">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="usernameColumn" text="Tên đăng nhập" prefWidth="150"/>
                <TableColumn fx:id="fullNameColumn" text="Họ tên" prefWidth="180"/>
                <TableColumn fx:id="roleColumn" text="Vai trò" prefWidth="140"/>
                <TableColumn fx:id="activeColumn" text="Trạng thái" prefWidth="100"/>
                <TableColumn fx:id="actionColumn" text="Thao tác" prefWidth="140"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
