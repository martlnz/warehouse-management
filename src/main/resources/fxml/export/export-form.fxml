<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <top>
        <Label text="Tạo phiếu xuất kho" style="-fx-font-size: 16px; -fx-font-weight: bold;">
            <BorderPane.margin><Insets bottom="12"/></BorderPane.margin>
        </Label>
    </top>
    <center>
        <VBox spacing="14">
            <GridPane hgap="10" vgap="8">
                <Label text="Khách hàng:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="customerComboBox" prefWidth="260" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Ghi chú:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextArea fx:id="noteTextArea" prefRowCount="2" prefWidth="260" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>

            <Label text="Thêm sản phẩm vào phiếu" style="-fx-font-weight: bold;"/>
            <HBox spacing="8">
                <ComboBox fx:id="productComboBox" promptText="Chọn sản phẩm" prefWidth="200"/>
                <TextField fx:id="quantityTextField" promptText="Số lượng" prefWidth="90"/>
                <TextField fx:id="unitPriceTextField" promptText="Đơn giá" prefWidth="100"/>
                <Button fx:id="addLineButton" text="+ Thêm dòng"/>
            </HBox>

            <TableView fx:id="detailTableView" prefHeight="220">
                <columns>
                    <TableColumn fx:id="lineProductColumn" text="Sản phẩm" prefWidth="200"/>
                    <TableColumn fx:id="lineQuantityColumn" text="Số lượng" prefWidth="90"/>
                    <TableColumn fx:id="lineUnitPriceColumn" text="Đơn giá" prefWidth="100"/>
                    <TableColumn fx:id="lineSubtotalColumn" text="Thành tiền" prefWidth="110"/>
                    <TableColumn fx:id="lineRemoveColumn" text="" prefWidth="70"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <BorderPane.margin><Insets top="12"/></BorderPane.margin>
            <Label text="Tổng tiền:"/>
            <Label fx:id="totalLabel" text="0" style="-fx-font-weight: bold;"/>
            <Button fx:id="cancelButton" text="Hủy"/>
            <Button fx:id="saveButton" text="Lưu phiếu xuất" style="-fx-font-weight: bold;"/>
        </HBox>
    </bottom>
</BorderPane>
