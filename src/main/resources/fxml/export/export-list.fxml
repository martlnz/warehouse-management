<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <top>
        <VBox spacing="10">
            <Label text="Phiếu xuất kho" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <HBox spacing="8">
                <TextField fx:id="searchTextField" promptText="Tìm theo khách hàng..." prefWidth="220"/>
                <Button fx:id="searchButton" text="Tìm kiếm"/>
                <Button fx:id="addButton" text="+ Tạo phiếu xuất"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="exportTableView">
            <columns>
                <TableColumn fx:id="idColumn" text="Mã phiếu" prefWidth="80"/>
                <TableColumn fx:id="dateColumn" text="Ngày tạo" prefWidth="140"/>
                <TableColumn fx:id="customerColumn" text="Khách hàng" prefWidth="180"/>
                <TableColumn fx:id="createdByColumn" text="Người tạo" prefWidth="140"/>
                <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="110"/>
                <TableColumn fx:id="actionColumn" text="Thao tác" prefWidth="120"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
