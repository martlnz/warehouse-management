<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <top>
        <VBox spacing="10">
            <Label text="Quản lý sản phẩm" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <HBox spacing="8">
                <TextField fx:id="searchTextField" promptText="Tìm theo tên hoặc mã sản phẩm..." prefWidth="240"/>
                <Button fx:id="searchButton" text="Tìm kiếm"/>
                <Button fx:id="addButton" text="+ Thêm sản phẩm"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="productTableView">
            <columns>
                <TableColumn fx:id="codeColumn" text="Mã SP" prefWidth="100"/>
                <TableColumn fx:id="nameColumn" text="Tên sản phẩm" prefWidth="220"/>
                <TableColumn fx:id="categoryColumn" text="Danh mục" prefWidth="140"/>
                <TableColumn fx:id="quantityColumn" text="Tồn kho" prefWidth="90"/>
                <TableColumn fx:id="priceColumn" text="Đơn giá" prefWidth="110"/>
                <TableColumn fx:id="actionColumn" text="Thao tác" prefWidth="140"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
